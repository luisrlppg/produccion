# ─────────────────────────────────────────────────────────────────────────────
# PPG Unified — variables de entorno
# Copia este archivo a .env y rellena los valores reales
# ─────────────────────────────────────────────────────────────────────────────

# ── Aplicación ────────────────────────────────────────────────────────────────
APP_PORT=5000
# URL base de la app (para incluir links en notificaciones)
APP_BASE_URL=http://192.168.1.160:5000
# Credenciales únicas para toda la app
APP_USERNAME=admin
APP_PASSWORD=ppg1234
# Contraseña adicional para operaciones destructivas (eliminar reportes)
ADMIN_PASSWORD=admin_secret
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_segura

# ── Odoo ──────────────────────────────────────────────────────────────────────
ODOO_URL=http://192.168.1.160:8070/
ODOO_DB=ppg
ODOO_USERNAME=admin
ODOO_PASSWORD=odooppg

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASSWORD=tu_password_de_aplicacion

# Destinatarios globales (fallback si no hay específicos por tipo)
EMAIL_RECIPIENTS=dest1@empresa.com,dest2@empresa.com

# Destinatarios por tipo de reporte (opcional — sobreescribe los globales)
PRODUCTION_EMAIL_RECIPIENTS=produccion@empresa.com,gerencia@empresa.com
PERSONAL_EMAIL_RECIPIENTS=rh@empresa.com
COMPANY_EMAIL_RECIPIENTS=mantenimiento@empresa.com

# ── Telegram ──────────────────────────────────────────────────────────────────
# 1. Crea un bot con @BotFather → /newbot → copia el token
# 2. Obtén tu chat_id con @userinfobot
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Chat IDs globales (fallback)
TELEGRAM_CHAT_IDS=-1001234567890

# Chat IDs por tipo (opcional — sobreescribe los globales)
TELEGRAM_PRODUCTION_RECIPIENTS=-1001234567890,-1001234567891
TELEGRAM_PERSONAL_RECIPIENTS=-1001234567890
TELEGRAM_COMPANY_RECIPIENTS=-1001234567890
# Para alertas de stock (usa TELEGRAM_CHAT_IDS como fallback si no se define)
# TELEGRAM_STOCK_RECIPIENTS=-1001234567890

# ── WhatsApp — CallMeBot (gratuito, personal) ─────────────────────────────────
# 1. Agrega +34 644 59 78 19 a tus contactos de WhatsApp
# 2. Envíale: I allow callmebot to send me messages
# 3. Recibirás tu apikey en ~1 minuto
# Formato: +521234567890:apikey1,+529876543210:apikey2
CALLMEBOT_NUMBERS=+521234567890:123456

# Por tipo (opcional)
WHATSAPP_PRODUCTION_RECIPIENTS=+521234567890:123456
WHATSAPP_PERSONAL_RECIPIENTS=+521234567890:123456
WHATSAPP_COMPANY_RECIPIENTS=+521234567890:123456

# ── WhatsApp — Meta Business API (oficial, de pago) ───────────────────────────
# Solo si tienes cuenta Meta Business
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_RECIPIENTS=
